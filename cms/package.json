{
  "name": "hieubanthan-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "test": "node --test src/kiem-dinh/*.test.ts src/lib/*.test.ts src/bai-khoi-tao/*.test.ts",
    "test:tich-hop": "payload run tests/tich-hop.ts",
    "test:kho-anh": "payload run tests/kho-anh-s3.ts",
    "e2e": "playwright test",
    "vercel-build": "node scripts/kiem-env.mjs && node scripts/van-tay-kb.mjs && node scripts/migrate.mjs && next build",
    "van-tay-kb": "node scripts/van-tay-kb.mjs",
    "predev": "node scripts/van-tay-kb.mjs",
    "pretest:tich-hop": "node scripts/van-tay-kb.mjs",
    "pree2e": "node scripts/van-tay-kb.mjs",
    "prebuild": "node scripts/van-tay-kb.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.11.0",
    "next": "16.4.2",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "overrides": {
    "undici": "7.30.0",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
