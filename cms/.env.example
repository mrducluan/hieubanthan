# CMS Hiểu Bản Thân — đặt trong Vercel (project cms), KHÔNG commit giá trị thật.
DATABASE_URI=postgres://USER:PASS@HOST:5432/postgres     # Supabase: chuỗi "Session pooler"; bảng nằm trong schema "cms"
PAYLOAD_SECRET=                                         # chuỗi ngẫu nhiên ≥ 32 ký tự (openssl rand -base64 48)
CMS_URL=https://cms.hieuban.com
WEB_URL=https://hieuban.com
CMS_EMAIL_QUAN_TRI=                                     # email DUY NHẤT được tạo tài khoản quản trị đầu tiên
CMS_WEBHOOK_SECRET=                                     # đặt giống bên web
CMS_PREVIEW_SECRET=                                     # đặt giống bên web
CRON_SECRET=                                            # Vercel Cron tự gửi (lịch xuất bản)
# Ảnh (Supabase Storage → S3): Project Settings → Storage → S3 Connection. Khoá bí mật chỉ hiện MỘT lần — dán đúng, không
# kèm dấu cách / ngoặc (code tự bỏ, nhưng sai ký tự thì 403 SignatureDoesNotMatch). S3_REGION = vùng của dự án Supabase.
# Cloudflare R2 thay thế: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com (không kèm tên bucket), S3_REGION=auto,
# S3_PUBLIC_URL = tên miền ảnh / r2.dev (gốc bucket) — docs/LUU-TRU-MEDIA.md mục 4. Kiểm: Thư viện ảnh → "Kiểm tra kho ảnh".
S3_BUCKET=cms-media
S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://<project>.supabase.co/storage/v1/object/public/cms-media
# CMS-2: trợ lý AI soạn nháp đoạn văn (dùng lại engine; hạn mức lượt AI quản trị ở engine LLM_QT_LUOT_NGAY)
ENGINE_URL=https://<engine>.onrender.com
ENGINE_API_KEY=                                         # giống bên web
# CMS-2: bắt buộc xác thực 2 bước cho Quản trị + Chủ biên (đặt =1 SAU KHI chính anh đã bật MFA cho tài khoản mình)
CMS_BAT_BUOC_MFA=
# BLOG-3: sửa bài trao đổi NotFair trong CMS. Có khoá → CMS gọi thẳng NotFair; KHÔNG đặt cũng được: CMS đọc bài qua web
# (GET {WEB_URL}/api/cms/notfair, xác thực bằng CMS_WEBHOOK_SECRET) — web đã có khoá để dựng /blog.
NOTFAIR_SEO_API_KEY=
