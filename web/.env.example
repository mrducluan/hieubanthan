# Mẫu biến môi trường cho web. Copy thành .env.local để chạy máy, và khai
# tương ứng trong bảng điều khiển Vercel khi deploy. KHÔNG commit .env.local.

# Địa chỉ engine. Local: http://localhost:8000. Staging: URL host engine
# (vd https://hieubanthan-engine.onrender.com).
ENGINE_URL=http://localhost:8000

# Khoá bí mật web↔engine. Để trống khi chạy máy. Khi deploy: sinh một chuỗi
# ngẫu nhiên dài, đặt GIỐNG NHAU ở đây và ở env của engine.
ENGINE_API_KEY=

# Mật khẩu bảo vệ bản staging. Để trống = không gác (dev local / bản công khai).
# Khi deploy staging: đặt cả hai để chỉ mình bạn xem được.
STAGING_USER=
STAGING_PASS=
