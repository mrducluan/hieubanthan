# Mẫu biến môi trường cho web. Copy thành .env.local để chạy máy, và khai
# tương ứng trong bảng điều khiển Vercel khi deploy. KHÔNG commit .env.local.

# Địa chỉ engine. Local: http://localhost:8000. Staging: URL host engine
# (vd https://hieubanthan-engine.onrender.com).
ENGINE_URL=http://localhost:8000

# Khoá bí mật web↔engine. Để trống khi chạy máy. Khi deploy: sinh một chuỗi
# ngẫu nhiên dài, đặt GIỐNG NHAU ở đây và ở env của engine.
ENGINE_API_KEY=

# URL công khai của web (ảnh OG, link chia sẻ). Vd https://hieubanthan.vn
NEXT_PUBLIC_SITE_URL=

# Khoá ký link chia sẻ / lời mời hợp đôi (HMAC). BẮT BUỘC khi deploy (≥16 ký tự ngẫu nhiên).
# Đổi khoá = mọi link cũ hết hiệu lực. Để trống khi chạy máy (dùng khoá dev).
LOI_MOI_SECRET=
# SAO-LG: "1" = Luận giải toàn bộ trừ 10 Sao/báo cáo (cần Supabase + migration 0008). Để trống = miễn phí.
LUAN_GIAI_THU_SAO=

# Đo lường funnel (PostHog). Để trống = không gửi gì (UI vẫn chạy). Không bao giờ gửi ngày sinh/tên/câu hỏi.
NEXT_PUBLIC_POSTHOG_KEY=
# Mặc định https://us.i.posthog.com — dùng https://eu.i.posthog.com nếu tạo dự án ở vùng EU.
NEXT_PUBLIC_POSTHOG_HOST=


# Tài khoản (UI-4, tuỳ chọn). Để trống = ẩn đăng nhập, hồ sơ chỉ lưu trên máy.
# Cần chạy migration supabase/migrations/0006_ho_so.sql và bật Auth: Email, Google, Phone (SMS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CHỈ server (xoá tài khoản). Không bao giờ đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Trang quản trị — kho tri thức (QT-1). CHỈ server. Fine-grained token, chỉ repo này, quyền
# Contents + Pull requests: Read and write. "Xuất bản" = mở PR, không ghi thẳng main. Trống = chỉ báo chưa kết nối.
QUAN_TRI_GITHUB_TOKEN=
# Mặc định mrducluan/hieubanthan
QUAN_TRI_GITHUB_REPO=

# Giám sát lỗi (Sentry, tuỳ chọn). Để trống = tắt, không tải thêm gì. Không bao giờ gửi body/ngày sinh/tên.
# NEXT_PUBLIC_SENTRY_DSN cho trình duyệt; SENTRY_DSN (nếu khác) cho phía server của web.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# PL-1 — thông tin đơn vị vận hành (footer + trang Chính sách/Điều khoản/Liên hệ). Để trống = ẩn ở footer,
# trang pháp lý ghi "đang cập nhật". Điền đúng thông tin pháp lý thật (cá nhân hoặc doanh nghiệp/hộ kinh doanh).
THONG_TIN_CHU_SO_HUU=        # trống = Hieu Ban Co Ltd (mặc định trong code)
THONG_TIN_MA_SO=
THONG_TIN_NOI_CAP=
THONG_TIN_DIA_CHI=
THONG_TIN_EMAIL=             # trống = contact@hieuban.com
THONG_TIN_EMAIL_DU_LIEU=
THONG_TIN_DIEN_THOAI=
# Link xác nhận "Đã thông báo Bộ Công Thương" (online.gov.vn) — chỉ điền sau khi đăng ký (bắt buộc trước khi bán Sao).
THONG_TIN_BO_CONG_THUONG_URL=
# Mạng xã hội (https://…). Để trống = không hiện biểu tượng.
MXH_FACEBOOK=
MXH_ZALO=
MXH_TIKTOK=
MXH_YOUTUBE=

# SEO-D: xác minh chủ sở hữu bằng thẻ meta (chỉ dán phần content="…"). Trống = không in thẻ.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Tag Manager (GTM-XXXXXXX) hoặc GA4 trực tiếp (G-XXXXXXX). Có GTM thì GA4 cấu hình trong GTM, bỏ trống GA_ID.
# Chỉ tải sau khi người dùng bấm "Đồng ý" ở hộp hỏi cookie. Trống cả hai = không hỏi, không tải.
NEXT_PUBLIC_GTM_ID=          # trống = GTM-KNZL39CS (mặc định trong code); "off" = tắt
NEXT_PUBLIC_GA_ID=
# Tên miền thêm vào CSP (img/connect/frame) cho thẻ bên thứ ba cài qua GTM, cách nhau dấu phẩy. Vd Meta Pixel:
# CSP_THEM_MIEN=https://connect.facebook.net,https://www.facebook.com
CSP_THEM_MIEN=
