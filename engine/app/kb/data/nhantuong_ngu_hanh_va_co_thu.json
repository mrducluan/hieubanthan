    {
      "ma": "R_YLZ_QING_p0016_s06_01",
      "dieu_kien_han": "",
      "dieu_kien_vi": "trẻ đầu nhỏ",
      "luan_han": "",
      "luan_vi": "khó thành người"
    },
    {
      "ma": "R_YLZ_QING_p0016_s06_02",
      "dieu_kien_han": "",
      "dieu_kien_vi": "đầu nhọn",
      "luan_han": "",
      "luan_vi": "không thành người"
    },
    {
      "ma": "R_YLZ_QING_p0016_s06_03",
      "dieu_kien_han": "",
      "dieu_kien_vi": "trẻ đỉnh đầu bằng, mày rậm, da rộng",
