      "luan_vi": "dễ nuôi"
    },
    {
      "ma": "R_YLZ_QING_p0016_s06_04",
      "dieu_kien_han": "",
      "dieu_kien_vi": "trẻ mày nhạt",
      "luan_han": "",
      "luan_vi": "không thọ (người lớn thì ngược lại)"
