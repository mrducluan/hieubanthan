      "luan_vi": "vẫn có thể quý hoặc giàu"
    },
    {
      "ma": "R_YLZ_QING_p0016_s03_02",
      "dieu_kien_han": "",
      "dieu_kien_vi": "tướng toàn đẹp nhưng có một chỗ phá",
      "luan_han": "",
      "luan_vi": "bất lợi"
    },
    {
      "ma": "R_YLZ_QING_p0016_s03_03",
      "dieu_kien_han": "",
      "dieu_kien_vi": "xem tướng",
      "luan_han": "",
      "luan_vi": "phải xét cả âm thanh rồi mới xem ngũ quan lục phủ"
    },
    {
      "ma": "R_YLZ_QING_p0016_s04_01",
      "dieu_kien_han": "",
      "dieu_kien_vi": "xem tướng",
      "luan_han": "",
      "luan_vi": "phải xem toàn thân cùng mọi vết, sẹo, nốt ruồi, lông tóc"
