    {
      "ma": "R_YLZ_QING_p0017_s01_01",
      "dieu_kien_han": "",
      "dieu_kien_vi": "trẻ da căng",
      "luan_han": "",
      "luan_vi": "tính nóng vội, rất khó nuôi"
    },
    {
      "ma": "R_YLZ_QING_p0017_s02_01",
      "dieu_kien_han": "",
      "dieu_kien_vi": "thiếu nữ tóc đen, mắt dài, tai ngay",
