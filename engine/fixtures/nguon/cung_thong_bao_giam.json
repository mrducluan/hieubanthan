    "can_trong_cau": [
     "Canh",
     "Tân",
     "Nhâm"
    ],
    "trich": "五月癸水，至弱无根，必须庚辛为生身之本。五月癸水，庚辛壬参酌并用可也。",
    "muc": "三夏癸水 · 五月"
