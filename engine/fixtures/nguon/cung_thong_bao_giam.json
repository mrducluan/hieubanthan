     "Tân"
    ],
    "trich": "二月癸水，不刚不柔，乙木司令，洩弱元神，专以庚金为用，辛金次之。",
    "muc": "三春癸水 · 二月"
   },
   "Thìn": {
    "can": [
     "Bính",
     "Tân",
