    ],
    "can_trong_cau": [
     "Bính",
     "Tân",
     "Giáp"
    ],
    "trich": "三月癸水，要分清明谷雨。清明后专用丙火；谷雨后，虽用丙火，尚宜辛甲佐之。",
    "muc": "三春癸水 · 三月"
   },
   "Tỵ": {
    "can": [
     "Tân"
    ],
    "can_trong_cau": [
     "Tân"
    ],
    "trich": "四月癸水，喜辛金为用，无辛用庚。",
    "muc": "三夏癸水 · 四月"
