    "can_trong_cau": [
     "Tân",
     "Bính"
    ],
    "trich": "正月癸水，值三阳之候，雨露之精，其性至柔，先用辛金，生癸水之源，次用丙火照暖。",
    "muc": "三春癸水 · 正月"
