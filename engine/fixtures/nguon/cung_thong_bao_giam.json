{
 "_nguon": "窮通寶鑑 (Cùng Thông Bảo Giám; còn gọi Lan Giang Võng, Tạo Hoá Nguyên Thược), Dư Xuân Đài biên — 120 ô nhật can × tháng. Cổ thư công cộng. `trich` = câu then chốt của ô; `can_trong_cau` = can đọc thẳng từ câu đó; `can` = bảng điều hậu: can trong câu trước (đúng thứ tự sách), rồi tới can sách nêu ở đoạn sau của tháng / tổng luận mùa.",
 "ban": "bộ dữ liệu tianzhi-classics, commit 047b827 (đối chiếu Wikisource «穷通宝鉴»)",
 "source_id": "cung_thong_bao_giam",
 "school_id": "dieu_hau",
 "o": {
  "Giáp": {
   "Dần": {
    "can": [
     "Bính",
     "Quý"
    ],
    "can_trong_cau": [
     "Bính",
     "Quý"
    ],
    "trich": "初春尚有余寒，得丙癸逢，富贵双全。癸藏丙透，名寒木向阳，主大富贵。",
    "muc": "三春甲木 · 正月"
   },
   "Mão": {
    "can": [
     "Canh",
     "Bính",
     "Đinh"
    ],
    "can_trong_cau": [
     "Canh"
    ],
    "trich": "二月甲木，庚金得所，名阳刃驾杀，可云小贵，异途显达，或主武职，但要财资之。",
    "muc": "三春甲木 · 二月"
   },
   "Thìn": {
    "can": [
     "Canh",
     "Nhâm",
     "Đinh"
    ],
    "can_trong_cau": [
     "Canh",
     "Nhâm"
    ],
    "trich": "三月甲木，木气相竭。先取庚金，次用壬水。庚壬两透，一榜堪图。",
    "muc": "三春甲木 · 三月"
   },
   "Tỵ": {
    "can": [
     "Quý",
     "Đinh",
     "Canh"
    ],
    "can_trong_cau": [
     "Quý",
     "Đinh"
    ],
    "trich": "四月甲木退气，丙火司权，先癸后丁。",
    "muc": "三夏甲木 · 四月"
   },
   "Ngọ": {
    "can": [
     "Quý",
     "Đinh",
     "Canh"
    ],
    "can_trong_cau": [
     "Quý",
     "Đinh",
     "Canh"
    ],
    "trich": "五六月甲木，木性虚焦，一理共推。五月先癸后丁，庚金次之。",
    "muc": "三夏甲木 · 五月"
   },
   "Mùi": {
    "can": [
     "Đinh",
     "Canh"
    ],
    "can_trong_cau": [
     "Đinh",
     "Canh"
    ],
    "trich": "六月三伏生寒，丁火退气。先丁后庚，无癸亦可。",
    "muc": "三夏甲木 · 六月"
   },
   "Thân": {
    "can": [
     "Đinh",
     "Canh"
    ],
    "can_trong_cau": [
     "Đinh",
     "Canh"
    ],
    "trich": "七月甲木，丁火为尊，庚金次之，庚金不可少。",
    "muc": "三秋甲木 · 七月"
   },
   "Dậu": {
    "can": [
     "Đinh",
     "Bính",
     "Canh"
    ],
    "can_trong_cau": [
     "Đinh",
     "Bính",
     "Canh"
    ],
    "trich": "八月甲木，木囚金旺。丁火为先，次用丙火，庚金再次。",
    "muc": "三秋甲木 · 八月"
   },
   "Tuất": {
    "can": [
     "Đinh",
     "Nhâm",
     "Quý",
     "Canh"
    ],
    "can_trong_cau": [
     "Đinh",
     "Nhâm",
     "Quý"
    ],
    "trich": "九月甲木，木星凋零，独爱丁火，壬癸滋扶，丁壬癸透，戊己亦透，此命配得中和，可许一榜。",
    "muc": "三秋甲木 · 九月"
   },
   "Hợi": {
    "can": [
     "Canh",
     "Đinh",
     "Bính",
     "Mậu"
    ],
    "can_trong_cau": [
     "Canh",
     "Đinh",
     "Bính"
    ],
    "trich": "十月甲木，庚丁为要，丙火次之。",
    "muc": "三冬甲木 · 十月"
   },
   "Tý": {
    "can": [
     "Đinh",
     "Canh",
     "Bính"
    ],
    "can_trong_cau": [
     "Đinh",
     "Canh",
     "Bính"
    ],
    "trich": "十一月甲木，木性生寒，丁先庚后，丙火佐之。",
    "muc": "三冬甲木 · 十一月"
   },
   "Sửu": {
    "can": [
     "Canh",
     "Đinh",
     "Bính"
    ],
    "can_trong_cau": [
     "Canh",
     "Đinh"
    ],
    "trich": "十二月甲木，天寒气冻，木性极寒，先用庚劈甲，方引丁火。",
    "muc": "三冬甲木 · 十二月"
   }
  },
  "Ất": {
   "Dần": {
    "can": [
     "Bính",
     "Quý"
    ],
    "can_trong_cau": [
     "Bính",
     "Quý"
    ],
    "trich": "正月乙木，必须用丙，因天气尤有余寒，非丙不暖，故以丙火为先，癸水次之。",
    "muc": "三春乙木 · 正月"
   },
   "Mão": {
    "can": [
     "Bính",
     "Quý"
    ],
    "can_trong_cau": [
     "Bính",
     "Quý"
    ],
    "trich": "二月乙木，阳气渐升，木不寒矣，以丙为君，癸为臣，丙癸两透，不透庚金，大富大贵。",
    "muc": "三春乙木 · 二月"
   },
   "Thìn": {
    "can": [
     "Quý",
     "Bính",
     "Mậu"
    ],
    "can_trong_cau": [
     "Quý",
     "Bính"
    ],
    "trich": "三月乙木，阳气愈炽，先癸后丙。",
    "muc": "三春乙木 · 三月"
   },
   "Tỵ": {
    "can": [
     "Quý"
    ],
    "can_trong_cau": [
     "Quý"
    ],
    "trich": "四月乙木，自有丙火，耑取癸水为尊。",
    "muc": "三夏乙木 · 四月"
   },
   "Ngọ": {
    "can": [
     "Quý",
     "Bính"
    ],
    "can_trong_cau": [
     "Quý",
     "Bính"
    ],
    "trich": "五月乙木，丁火司权，禾稼俱旱。上半月属阳，仍用癸水；下半月属阴，三伏生寒，丙癸齐用。",
    "muc": "三夏乙木 · 五月"
   },
   "Mùi": {
    "can": [
     "Bính",
     "Quý"
    ],
    "can_trong_cau": [
     "Bính",
     "Quý"
    ],
    "trich": "六月乙木，木性且寒，柱多金水，丙火为尊。",
    "muc": "三夏乙木 · 六月"
   },
   "Thân": {
    "can": [
     "Kỷ",
     "Bính",
     "Quý"
    ],
    "can_trong_cau": [
     "Kỷ",
     "Bính",
     "Quý"
    ],
    "trich": "七月乙木，庚金乘令。七月喜己土为用，或不见丙癸，亦是中下之命。",
    "muc": "三秋乙木 · 七月"
   },
   "Dậu": {
    "can": [
     "Quý",
     "Bính",
     "Đinh"
    ],
    "can_trong_cau": [
     "Quý",
     "Bính"
    ],
    "trich": "八月乙木，在白露之后，耑用癸水以滋桂萼；若秋分后，却喜向阳，又宜用丙，癸水次之。",
    "muc": "三秋乙木 · 八月"
   },
   "Tuất": {
    "can": [
     "Quý",
     "Tân"
    ],
    "can_trong_cau": [
     "Quý",
     "Tân"
    ],
    "trich": "九月乙木，根枯叶落，必赖癸水滋养。若见癸水，又遇辛金发水之源，定主科甲。",
    "muc": "三秋乙木 · 九月"
   },
   "Hợi": {
    "can": [
     "Bính",
     "Mậu"
    ],
    "can_trong_cau": [
     "Bính",
     "Mậu"
    ],
    "trich": "十月乙木，木不受气，而壬水司令，取丙为用，戊土次之。",
    "muc": "三冬乙木 · 十月"
   },
   "Tý": {
    "can": [
     "Bính"
    ],
    "can_trong_cau": [
     "Bính"
    ],
    "trich": "十一月乙木，花木寒冻，一阳来复，喜用丙火解冻，不宜用癸以冻花木，故耑用丙火。",
    "muc": "三冬乙木 · 十一月"
   },
   "Sửu": {
    "can": [
     "Bính"
    ],
    "can_trong_cau": [
     "Bính"
    ],
    "trich": "三冬乙木，寒木向阳，专用丙火。",
    "muc": "三冬乙木 · 十二月"
   }
  },
  "Bính": {
   "Dần": {
    "can": [
     "Nhâm",
     "Canh"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Canh"
    ],
    "trich": "正月丙火，用壬，庚辛为助。",
    "muc": "三春丙火 · 正月"
   },
   "Mão": {
    "can": [
     "Nhâm",
     "Kỷ",
     "Mậu"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Kỷ"
    ],
    "trich": "二月丙火，阳气舒升，耑用壬水。或无壬水，己土姑用。",
    "muc": "三春丙火 · 二月"
   },
   "Thìn": {
    "can": [
     "Nhâm",
     "Giáp"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Giáp"
    ],
    "trich": "三月丙火，气渐炎升，用壬水。或成土局，取甲为辅，壬不可离。",
    "muc": "三春丙火 · 三月"
   },
   "Tỵ": {
    "can": [
     "Nhâm",
     "Canh",
     "Quý"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Canh"
    ],
    "trich": "四月耑用壬水，金为佐。",
    "muc": "三夏丙火 · 四月"
   },
   "Ngọ": {
    "can": [
     "Nhâm",
     "Canh"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Canh"
    ],
    "trich": "五月丙火，得壬高透，方为上命。",
    "muc": "三夏丙火 · 五月"
   },
   "Mùi": {
    "can": [
     "Nhâm",
     "Canh"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Canh"
    ],
    "trich": "六月丙火退气，三伏生寒，壬水为用，取庚辅佐。",
    "muc": "三夏丙火 · 六月"
   },
   "Thân": {
    "can": [
     "Nhâm",
     "Mậu"
    ],
    "can_trong_cau": [
     "Nhâm"
    ],
    "trich": "七月丙火，太阳转西，阳气衰矣。惟日照湖海，暮夜光天，故仍用壬水，辅映光辉。",
    "muc": "三秋丙火 · 七月"
   },
   "Dậu": {
    "can": [
     "Nhâm",
     "Quý"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Quý"
    ],
    "trich": "八月丙火，日近黄昏，丙火之余光，存于光湖，仍用壬水辅映。若无壬水，癸亦可用。",
    "muc": "三秋丙火 · 八月"
   },
   "Tuất": {
    "can": [
     "Giáp",
     "Nhâm"
    ],
    "can_trong_cau": [
     "Giáp",
     "Nhâm"
    ],
    "trich": "九月丙火，火气愈退，所忌土晦光火，必须先用甲木，次取壬水。",
    "muc": "三秋丙火 · 九月"
   },
   "Hợi": {
    "can": [
     "Giáp",
     "Mậu",
     "Canh",
     "Nhâm"
    ],
    "can_trong_cau": [
     "Giáp",
     "Mậu",
     "Canh"
    ],
    "trich": "十月丙火，太阳失令，得见甲戊庚出干，可云科甲。",
    "muc": "三冬丙火 · 十月"
   },
   "Tý": {
    "can": [
     "Nhâm",
     "Mậu",
     "Kỷ"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Mậu"
    ],
    "trich": "十一月丙火，冬至一阳生，弱中复强，壬水为最，戊土佐之。",
    "muc": "三冬丙火 · 十一月"
   },
   "Sửu": {
    "can": [
     "Nhâm",
     "Giáp"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Giáp"
    ],
    "trich": "十二月丙火，气进二阳，侮雪欺霜，喜壬为用。己土司令，土多又不可少甲。",
    "muc": "三冬丙火 · 十二月"
   }
  },
  "Đinh": {
   "Dần": {
    "can": [
     "Canh",
     "Giáp"
    ],
    "can_trong_cau": [
     "Canh",
     "Giáp"
    ],
    "trich": "正月丁火，甲木当权，乃为母旺，非庚不能劈甲，何以引丁，姑用庚金。",
    "muc": "三春丁火 · 正月"
   },
   "Mão": {
    "can": [
     "Canh",
     "Giáp"
    ],
    "can_trong_cau": [
     "Canh",
     "Giáp"
    ],
    "trich": "二月丁火，溼乙伤丁，先庚后甲，非庚不能去乙，非甲不能引丁。",
    "muc": "三春丁火 · 二月"
   },
   "Thìn": {
    "can": [
     "Giáp",
     "Canh",
     "Mậu"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh"
    ],
    "trich": "三月丁火，戊土司令，洩弱丁气，先用甲木引丁制土，次看庚金。",
    "muc": "三春丁火 · 三月"
   },
   "Tỵ": {
    "can": [
     "Giáp",
     "Canh"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh"
    ],
    "trich": "四月丁火乘旺，虽取甲引丁，必用庚劈甲。",
    "muc": "三夏丁火 · 四月"
   },
   "Ngọ": {
    "can": [
     "Quý",
     "Nhâm"
    ],
    "can_trong_cau": [
     "Quý"
    ],
    "trich": "五月丁火，时归建禄，不宜乱用甲木。得一癸透，名独杀当权，出人头地。",
    "muc": "三夏丁火 · 五月"
   },
   "Mùi": {
    "can": [
     "Giáp",
     "Nhâm",
     "Canh"
    ],
    "can_trong_cau": [
     "Giáp",
     "Nhâm"
    ],
    "trich": "六月之丁，阴柔退气，但值三伏生寒，丁弱极矣，专取甲木，壬水次之。",
    "muc": "三夏丁火 · 六月"
   },
   "Thân": {
    "can": [
     "Giáp",
     "Canh",
     "Bính",
     "Mậu"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh",
     "Bính"
    ],
    "trich": "七月丁火，退气柔弱，端用甲木，仍取庚劈甲，为引火之物，或借丙暖金晒甲。",
    "muc": "三秋丁火 · 七月"
   },
   "Dậu": {
    "can": [
     "Giáp",
     "Canh",
     "Bính",
     "Mậu"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh"
    ],
    "trich": "三秋丁火，退气柔弱，端用甲木，金虽乘旺司权，无伤丁之理，仍取庚劈甲。",
    "muc": "三秋丁火 · 八月"
   },
   "Tuất": {
    "can": [
     "Giáp",
     "Canh",
     "Mậu"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh"
    ],
    "trich": "或九月一派戊土，洩丁火之气，不见甲木，为伤官伤尽。用甲者，庚不可少。",
    "muc": "三秋丁火 · 九月"
   },
   "Hợi": {
    "can": [
     "Giáp",
     "Canh"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh"
    ],
    "trich": "三冬丁火，甲木为尊，庚金佐之，癸戊权宜酌用可也。",
    "muc": "三冬丁火 · 十月"
   },
   "Tý": {
    "can": [
     "Giáp",
     "Canh"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh"
    ],
    "trich": "三冬丁火，甲木为尊，庚金佐之，癸戊权宜酌用可也。",
    "muc": "三冬丁火 · 十一月"
   },
   "Sửu": {
    "can": [
     "Giáp",
     "Canh"
    ],
    "can_trong_cau": [
     "Giáp",
     "Canh"
    ],
    "trich": "三冬丁火，甲木为尊，庚金佐之，癸戊权宜酌用可也。",
    "muc": "三冬丁火 · 十二月"
   }
  },
  "Mậu": {
   "Dần": {
    "can": [
     "Bính",
     "Giáp",
     "Quý"
    ],
    "can_trong_cau": [
     "Bính",
     "Giáp",
     "Quý"
    ],
    "trich": "三春戊土，无丙照暖，戊土不生，无甲疏劈，戊土不灵，无癸滋润，万物不长。",
    "muc": "三春戊土 · 正月"
   },
   "Mão": {
    "can": [
     "Bính",
     "Giáp",
     "Quý"
    ],
    "can_trong_cau": [
     "Bính",
     "Giáp",
     "Quý"
    ],
    "trich": "正二月即有甲癸，若无丙除寒，如万物生而不长，故无丙者，富贵艰辛。",
    "muc": "三春戊土 · 二月"
   },
   "Thìn": {
    "can": [
     "Bính",
     "Giáp",
     "Quý"
    ],
    "can_trong_cau": [
     "Bính",
     "Giáp",
     "Quý"
    ],
    "trich": "三月戊土司令，不见丙甲癸者，愚而且贱。",
    "muc": "三春戊土 · 三月"
   },
   "Tỵ": {
    "can": [
     "Giáp",
     "Bính",
     "Quý"
    ],
    "can_trong_cau": [
     "Giáp",
     "Bính",
     "Quý"
    ],
    "trich": "四月戊土，阳气发升，寒气内藏，外实内虚，故先用甲疏劈，次取丙癸为佐。",
    "muc": "三夏戊土 · 四月"
   },
   "Ngọ": {
    "can": [
     "Nhâm",
     "Giáp",
     "Bính"
    ],
    "can_trong_cau": [
     "Nhâm",
     "Giáp",
