    "can_trong_cau": [
     "Tân",
     "Giáp"
    ],
    "trich": "九月癸水，失令无根，戊土司权，剋制太过，专用辛金发水之源，要比肩滋甲制戊方妙。",
    "muc": "三秋癸水 · 九月"
